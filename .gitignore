# eBPF Build Artifacts
# We ignore these because they are kernel-specific and should be 
# generated by the user running `make vmlinux` and `make agent`
bpf/vmlinux.h
bpf/vmlinux_err.log
bpf/*.bpf.o
agent/*.bpf.o

# Keep an example file if you have one
!bpf/monitor.bpf.o.example

